# ==========================================
# AASC Audit Platform - Environment Variables
# ==========================================

# Application Environment (production / staging / local)
APP_ENV=production
APP_DEBUG=false

# Database Configuration (Percona Server 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sitemanager
DB_USER=bitrix
DB_PASSWORD=your_secure_db_password

# Redis Pub/Sub & Caching Engine
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_CHANNEL=bitrix:pull:events

# Realtime & Automation Services
PUSH_SERVER_WS_PORT=8020
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/audit-lead-created

# Default User Credentials (Seeding)
DEFAULT_USER_PASSWORD=your_default_user_password
