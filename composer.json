{
  "name": "aasc/audit-platform",
  "description": "AASC Auditing CRM Platform on Bitrix24 D7",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Aasc\\Audit\\": "local/modules/aasc.audit/lib/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {}
  }
}
