bitrix/
/upload/
upload/

# 4. Logs, Dumps & Temporary Files
*.log
*.sql
*.tar.gz
*.zip
/tmp/
/scratch/
scratch/

# 5. IDE & Operating System
.idea/
.vscode/
*.swp
*.swo
.DS_Store
